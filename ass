           FROM cash_back_bonuses cbb
          WHERE cbb.delete_time IS NULL AND cbb.project::text = 'QuantumAccountHandlingFeeOnBehalf'::text AND cbb.status::text = 'Closed'::text AND to_date(cbb.month::text || '-01'::text, 'YYYY-MM-DD'::text) >= date_trunc('month'::text, CURRENT_DATE - '6 mons'::interval)::date
          GROUP BY (to_date(cbb.month::text || '-01'::text, 'YYYY-MM-DD'::text)), (cbb.account_id::text)
        ), v_cost_by_account_product AS (
         SELECT cost_union.settlement_month,
