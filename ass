                    abs(sum(COALESCE(q.rebate_interchange_base_amt, 0::numeric) * COALESCE(q.rebate_interchange_rate, 0::numeric) + COALESCE(q.rebate_incentive_base_amt, 0::numeric) * COALESCE(q.rebate_incentive_rate, 0::numeric)))::numeric(20,4) AS channel_rebate
                   FROM dws.dws_qi_card_finance_daily_v2_p q
                     LEFT JOIN account_root_relation aar ON aar.account_id::text = q.account_id::text
                  WHERE q.delete_time IS NULL AND q.report_date >= date_trunc('month'::text, CURRENT_DATE - '6 mons'::interval)::date
                  GROUP BY (date_trunc('month'::text, q.report_date::timestamp with time zone)::date), (COALESCE(aar.root_id, q.account_id))) rebate_union
          GROUP BY rebate_union.settlement_month, rebate_union.root_account_id, rebate_union.product, rebate_union.provider
        ), qbit_card_customer_rebate_cost AS (
         SELECT to_date(cbb.month::text || '-01'::text, 'YYYY-MM-DD'::text) AS settlement_month,
            cbb.account_id::text AS root_account_id,
