          GROUP BY cost_union.settlement_month, cost_union.root_account_id, cost_union.product, cost_union.provider
        ), revenue_cost_allocated AS (
         SELECT x.report_date,
            x.settlement_month,
            x.root_account_id,
            x.product,
            x.provider,
            x.item,
            x.source_type,
            x.commission_stage,
            x.sale_id,
            x.department_id,
            x.am_id,
            x.activity_month,
            x.collection_month,
            x.payable_settlement_month,
            x.effective_revenue,
            x.provider_cogs,
            x.unscoped_cogs,
            x.provider_metric_deduction,
            x.unscoped_metric_deduction,
            x.total_channel_rebate,
            x.total_customer_rebate_cost,
            x.product_effective_revenue,
            x.all_product_effective_revenue,
            x.qbit_card_effective_revenue,
            x.cost_allocation_rn,
            x.all_cost_allocation_rn,
            GREATEST(x.effective_revenue +
                CASE
                    WHEN x.product_effective_revenue <> 0::numeric THEN x.total_channel_rebate * x.effective_revenue / x.product_effective_revenue
                    ELSE 0::numeric
                END -
                CASE
                    WHEN x.product::text = 'qbit_card'::text AND x.qbit_card_effective_revenue <> 0::numeric THEN x.total_customer_rebate_cost * x.effective_revenue / x.qbit_card_effective_revenue
                    ELSE 0::numeric
                END -
                CASE
                    WHEN x.product_effective_revenue <> 0::numeric THEN x.provider_metric_deduction * x.effective_revenue / x.product_effective_revenue
                    ELSE 0::numeric
                END -
                CASE
                    WHEN x.all_product_effective_revenue <> 0::numeric THEN x.unscoped_metric_deduction * x.effective_revenue / x.all_product_effective_revenue
                    ELSE 0::numeric
                END, 0::numeric)::numeric(20,4) AS allocated_effective_revenue,
            (
                CASE
                    WHEN x.product_effective_revenue <> 0::numeric THEN x.provider_cogs * x.effective_revenue / x.product_effective_revenue
                    WHEN x.cost_allocation_rn = 1 THEN x.provider_cogs
                    ELSE 0::numeric
                END +
                CASE
                    WHEN x.all_product_effective_revenue <> 0::numeric THEN x.unscoped_cogs * x.effective_revenue / x.all_product_effective_revenue
                    WHEN x.all_cost_allocation_rn = 1 THEN x.unscoped_cogs
                    ELSE 0::numeric
                END)::numeric(20,4) AS allocated_cogs
           FROM ( SELECT b.report_date,
                    b.settlement_month,
                    b.root_account_id,
                    b.product,
                    b.provider,
                    b.item,
                    b.source_type,
                    b.commission_stage,
                    b.sale_id,
                    b.department_id,
                    b.am_id,
                    b.activity_month,
                    b.collection_month,
                    b.payable_settlement_month,
                    b.effective_revenue,
                    COALESCE(c.provider_cogs, 0::numeric)::numeric(20,4) AS provider_cogs,
                    COALESCE(c.unscoped_cogs, 0::numeric)::numeric(20,4) AS unscoped_cogs,
                    COALESCE(md.provider_metric_deduction, 0::numeric)::numeric(20,4) AS provider_metric_deduction,
                    COALESCE(md.unscoped_metric_deduction, 0::numeric)::numeric(20,4) AS unscoped_metric_deduction,
                    COALESCE(r.channel_rebate, 0::numeric)::numeric(20,4) AS total_channel_rebate,
                    COALESCE(cr.customer_rebate_cost, 0::numeric)::numeric(20,4) AS total_customer_rebate_cost,
                    sum(b.effective_revenue) OVER (PARTITION BY b.settlement_month, b.root_account_id, b.product, (COALESCE(b.provider, ''::character varying)))::numeric(20,4) AS product_effective_revenue,
                    sum(b.effective_revenue) OVER (PARTITION BY b.settlement_month, b.root_account_id, b.product)::numeric(20,4) AS all_product_effective_revenue,
                    sum(
                        CASE
                            WHEN b.product::text = 'qbit_card'::text THEN b.effective_revenue
                            ELSE 0::numeric
                        END) OVER (PARTITION BY b.settlement_month, b.root_account_id, b.product)::numeric(20,4) AS qbit_card_effective_revenue,
                    row_number() OVER (PARTITION BY b.settlement_month, b.root_account_id, b.product, (COALESCE(b.provider, ''::character varying)) ORDER BY (
                        CASE
                            WHEN b.effective_revenue <> 0::numeric THEN 0
                            ELSE 1
                        END), b.sale_id, b.department_id) AS cost_allocation_rn,
                    row_number() OVER (PARTITION BY b.settlement_month, b.root_account_id, b.product ORDER BY (
                        CASE
                            WHEN b.effective_revenue <> 0::numeric THEN 0
                            ELSE 1
                        END), b.sale_id, b.department_id) AS all_cost_allocation_rn
                   FROM revenue_base b
                     LEFT JOIN LATERAL ( SELECT sum(
                                CASE
                                    WHEN NULLIF(btrim(c_1.provider::text), ''::text) IS NULL THEN c_1.cogs
                                    ELSE 0::numeric
                                END) AS unscoped_cogs,
                            sum(
                                CASE
                                    WHEN NULLIF(btrim(c_1.provider::text), ''::text) IS NOT NULL AND NULLIF(btrim(c_1.provider::text), ''::text) = NULLIF(btrim(b.provider::text), ''::text) THEN c_1.cogs
                                    ELSE 0::numeric
                                END) AS provider_cogs
                           FROM v_cost_by_account_product c_1
                          WHERE c_1.settlement_month = b.settlement_month AND c_1.root_account_id::text = b.root_account_id::text AND c_1.product = b.product::text) c ON true
                     LEFT JOIN LATERAL ( SELECT sum(
                                CASE
                                    WHEN NULLIF(btrim(md_1.provider), ''::text) IS NULL THEN md_1.deduction_amount
                                    ELSE 0::numeric
                                END) AS unscoped_metric_deduction,
                            sum(
                                CASE
                                    WHEN NULLIF(btrim(md_1.provider), ''::text) IS NOT NULL AND NULLIF(btrim(md_1.provider), ''::text) = NULLIF(btrim(b.provider::text), ''::text) THEN md_1.deduction_amount
                                    ELSE 0::numeric
                                END) AS provider_metric_deduction
                           FROM commission_metric_deduction md_1
                          WHERE md_1.settlement_month = b.settlement_month AND md_1.root_account_id::text = b.root_account_id::text AND md_1.product = b.product::text) md ON true
                     LEFT JOIN qbit_card_channel_rebate r ON r.settlement_month = b.settlement_month AND r.root_account_id::text = b.root_account_id::text AND r.product = b.product::text AND COALESCE(r.provider, ''::text) = COALESCE(b.provider, ''::character varying)::text
                     LEFT JOIN qbit_card_customer_rebate_cost cr ON cr.settlement_month = b.settlement_month AND cr.root_account_id = b.root_account_id::text AND cr.product = b.product::text) x
        ), estimate_base AS (
         SELECT b.report_date,
            b.settlement_month,
            b.root_account_id,
            b.product,
            b.provider,
            b.item,
            b.source_type,
            b.commission_stage,
            b.sale_id,
            b.department_id,
            b.am_id,
            b.activity_month,
            b.collection_month,
            b.payable_settlement_month,
            b.allocated_effective_revenue AS effective_revenue,
            b.allocated_cogs AS cogs,
                CASE
                    WHEN b.department_id = '1851130772357509121'::text THEN (b.allocated_effective_revenue - b.allocated_cogs)::numeric(20,4)
                    ELSE GREATEST(b.allocated_effective_revenue - b.allocated_cogs, 0::numeric)::numeric(20,4)
                END AS gp,
                CASE
                    WHEN b.product::text = 'qbit_card'::text AND (a.card_active_time IS NULL OR a.card_active_time::date > (b.settlement_month + '1 mon'::interval)::date) THEN 0
                    WHEN b.product::text = 'qbit_card'::text THEN (b.settlement_month + '1 mon'::interval)::date - a.card_active_time::date
                    WHEN b.product::text = 'group_account'::text AND (a.global_active_time IS NULL OR a.global_active_time::date > (b.settlement_month + '1 mon'::interval)::date) THEN 0
                    WHEN b.product::text = 'group_account'::text THEN (b.settlement_month + '1 mon'::interval)::date - a.global_active_time::date
                    WHEN b.product::text = 'crypto'::text AND (a.crypto_active_time IS NULL OR a.crypto_active_time::date > (b.settlement_month + '1 mon'::interval)::date) THEN 0
                    WHEN b.product::text = 'crypto'::text THEN (b.settlement_month + '1 mon'::interval)::date - a.crypto_active_time::date
                    WHEN b.product::text = 'open_api'::text AND (a.api_active_time IS NULL OR a.api_active_time::date > (b.settlement_month + '1 mon'::interval)::date) THEN 0
                    WHEN b.product::text = 'open_api'::text THEN (b.settlement_month + '1 mon'::interval)::date - a.api_active_time::date
                    WHEN b.product::text = 'treasury'::text AND (a.treasury_active_time IS NULL OR a.treasury_active_time::date > (b.settlement_month + '1 mon'::interval)::date) THEN 0
                    WHEN b.product::text = 'treasury'::text THEN (b.settlement_month + '1 mon'::interval)::date - a.treasury_active_time::date
                    ELSE NULL::integer
                END AS active_days,
                CASE
                    WHEN a.referral_user_id IS NOT NULL AND a.referral_user_id::text = b.sale_id::text THEN 'direct'::text
                    ELSE 'non_direct'::text
                END AS invite_type
           FROM revenue_cost_allocated b
             LEFT JOIN dim.dim_account_analysis a ON a.account_id::text = b.root_account_id::text AND a.delete_time IS NULL
        ), rule_candidates AS (
         SELECT b.report_date,
            b.settlement_month,
            b.root_account_id,
            b.product,
            b.provider,
            b.item,
            b.source_type,
            b.commission_stage,
            b.sale_id,
            b.department_id,
            b.am_id,
            b.activity_month,
            b.collection_month,
            b.payable_settlement_month,
            b.effective_revenue,
            b.cogs,
            b.gp,
            b.active_days,
            b.invite_type,
            COALESCE(r.rule_code, 'NO_MATCHED_RULE'::character varying) AS rule_code,
            r.commission_base_type,
            COALESCE(r.commission_rate, 0::numeric)::numeric(20,6) AS commission_rate,
            row_number() OVER (PARTITION BY b.settlement_month, b.root_account_id, b.product, (COALESCE(b.provider, ''::character varying)), (COALESCE(b.item, ''::text)), (COALESCE(b.sale_id, ''::character varying)), b.source_type, b.commission_stage ORDER BY r.priority, r.id) AS rn
           FROM estimate_base b
             LEFT JOIN dim.dim_sales_commission_rule r ON r.department_id::text = b.department_id AND (r.product IS NULL OR r.product::text = b.product::text) AND (r.provider IS NULL OR r.provider::text = b.provider::text) AND (r.item IS NULL OR r.item::text = b.item) AND (r.invite_type::text = 'all'::text OR r.invite_type::text = b.invite_type) AND (r.active_days_min IS NULL OR b.active_days >= r.active_days_min) AND (r.active_days_max IS NULL OR b.active_days <= r.active_days_max) AND b.settlement_month::timestamp without time zone >= r.start_time AND b.settlement_month::timestamp without time zone < r.end_time AND r.enabled = true AND r.delete_time IS NULL
        )
 SELECT abs(hashtext(concat_ws(':'::text, to_char(rule_candidates.report_date::timestamp with time zone, 'YYYYMMDD'::text), to_char(rule_candidates.settlement_month::timestamp with time zone, 'YYYYMM'::text), rule_candidates.root_account_id, rule_candidates.product, COALESCE(rule_candidates.provider, ''::character varying), COALESCE(rule_candidates.item, ''::text), COALESCE(rule_candidates.sale_id, ''::character varying), rule_candidates.source_type, rule_candidates.commission_stage)))::bigint AS id,
    rule_candidates.report_date,
    rule_candidates.settlement_month,
    rule_candidates.root_account_id,
    rule_candidates.product,
    rule_candidates.provider,
    rule_candidates.item,
    rule_candidates.source_type,
    rule_candidates.commission_stage,
    rule_candidates.sale_id,
    rule_candidates.am_id,
    rule_candidates.department_id,
    rule_candidates.invite_type,
    rule_candidates.activity_month,
    rule_candidates.collection_month,
    rule_candidates.payable_settlement_month,
    rule_candidates.effective_revenue,
    rule_candidates.cogs,
    rule_candidates.gp,
        CASE
            WHEN rule_candidates.commission_base_type::text = 'actual_fee'::text THEN rule_candidates.effective_revenue
            ELSE rule_candidates.gp
        END AS commission_base,
    rule_candidates.commission_rate,
    (
        CASE
            WHEN rule_candidates.commission_base_type::text = 'actual_fee'::text THEN rule_candidates.effective_revenue
            ELSE rule_candidates.gp
        END * rule_candidates.commission_rate)::numeric(20,4) AS estimated_commission,
    rule_candidates.active_days,
    rule_candidates.rule_code,
    now() AS refreshed_at
   FROM rule_candidates
  WHERE rule_candidates.rn = 1;