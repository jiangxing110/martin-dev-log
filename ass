                    WHEN COALESCE(csdm.department_id, ''::text) <> '1851130772357509121'::text AND r.metric_code::text = 'assets_acceptance_fee_gt_zero'::text THEN COALESCE(r.income_value, 0::numeric) * 0.0009
                    ELSE 0::numeric
                END)::numeric(20,4) AS cogs
           FROM dws.dws_metrics_sales_revenue_monthly r
             LEFT JOIN sale_department_mapping sdm ON sdm.sale_id = COALESCE(r.sale_id, r.am_id)::text
             LEFT JOIN crypto_sale_department_mapping csdm ON csdm.sale_id = COALESCE(r.sale_id, r.am_id)::text
          WHERE r.delete_time IS NULL AND r.settlement_month >= date_trunc('month'::text, CURRENT_DATE - '6 mons'::interval)::date AND r.product::text = 'crypto_connect'::text AND (r.metric_code::text = ANY (ARRAY['assets_acceptance_fee_gt_zero'::character varying, 'assets_acceptance_fee_eq_zero'::character varying]::text[]))
          GROUP BY r.settlement_month, r.root_account_id, r.provider
        ), qbit_card_channel_rebate AS (
         SELECT rebate_union.settlement_month,
