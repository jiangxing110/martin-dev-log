          WHERE r.delete_time IS NULL AND r.settlement_month >= date_trunc('month'::text, CURRENT_DATE - '6 mons'::interval)::date AND ((r.product::text = 'qbit_card'::text AND r.metric_code::text = 'qbit_card_collection_fee'::text) OR (r.product::text = 'crypto_connect'::text AND r.metric_code::text = 'crypto_connect_income'::text))
          GROUP BY r.settlement_month, r.root_account_id, r.metric_code, (NULLIF(btrim(r.provider::text), ''::text))
        ), crypto_acceptance_cost AS (
         SELECT r.settlement_month,
