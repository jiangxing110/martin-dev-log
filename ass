          WHERE r.delete_time IS NULL AND r.settlement_month >= date_trunc('month'::text, CURRENT_DATE - '6 mons'::interval)::date AND r.product::text = 'qbit_card'::text AND r.provider::text = 'QI'::text AND r.metric_code::text = 'physical_card_cost'::text AND (sdm.department_id = ANY (ARRAY['1740319905791647746'::text, '1740319923059597313'::text]))
          GROUP BY r.settlement_month, r.root_account_id, r.provider
        ), global_account_offline_fee_cost AS (
