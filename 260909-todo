@Override
    @Transactional(rollbackFor = Exception.class)
    public WhiteLabelCustomerProfileSyncVO sync(WhiteLabelCustomerProfileSyncDTO request) {
        WhiteLabelCustomerProfileSyncVO result = new WhiteLabelCustomerProfileSyncVO();
        result.setRequestId(request.getRequestId());
        List<WhiteLabelCustomerProfileItemDTO> items = request.getProfiles();
        Set<String> accountIds = items.stream().map(WhiteLabelCustomerProfileItemDTO::getAccountId).collect(Collectors.toSet());
        if (accountIds.size() != items.size()) {
            addError(result, null, "同一请求内accountId不能重复");
            result.setFailedCount(items.size());
            return result;
        }

        Map<String, Account> accounts = new HashMap<>();
        List<Account> accountList = accountMapper.selectBatchIds(accountIds);
        accountList.forEach(account -> accounts.put(account.getId(), account));
        List<WhiteLabelCustomerProfileItemDTO> invalidItems = items.stream()
                .filter(item -> !accounts.containsKey(item.getAccountId()))
                .toList();
        if (!invalidItems.isEmpty()) {
            invalidItems.forEach(item -> addError(result, item.getAccountId(), "qbit账户不存在"));
            result.setFailedCount(invalidItems.size());
            return result;
        }
        for (WhiteLabelCustomerProfileItemDTO item : items) {
            upsert(item);
            result.setSuccessCount(result.getSuccessCount() + 1);
        }
        log.info("白标客户配置同步完成, requestId={}, successCount={}, failedCount={}",
                request.getRequestId(), result.getSuccessCount(), result.getFailedCount());
        return result;
    }
