    public Map<String, AccountWalletBalanceResponse> getAccountWalletBalanceMap(List<String> outAccountIds) {
        if (CollectionUtils.isEmpty(outAccountIds)) {
            return Collections.emptyMap();
        }
        String accountId = CurrentUserContext.getOuterAccountId();
        AccountBalanceDataRequest request = new AccountBalanceDataRequest();
        request.setAccountIds(outAccountIds);
        HttpHeaders httpHeaders = HeaderUtils.buildNodeHeaders(accountId, secret);
        AccountWalletBalanceDataResponse response = httpClientWrapper.post(
                gatewayUrl + "/qbit-assets/account/white-lable-wallet-balances",
                request,
                httpHeaders,
                AccountWalletBalanceDataResponse.class
        );
        if (response == null || response.getData() == null) {
            return Collections.emptyMap();
        }
        return response.getData();
    }