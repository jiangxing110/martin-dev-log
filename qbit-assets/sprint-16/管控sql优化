```sql
SELECT
    COALESCE(sum(case when qcte."type" = 'Consumption' and not qcte.business_code_list @> '1001'::jsonb and not qcte.business_code_list @> '1008'::jsonb and not qcte.business_code_list @> '1009'::jsonb and not qcte.business_code_list @> '1011'::jsonb and not qcte.business_code_list @> '1013'::jsonb and not qcte.business_code_list @> '1015'::jsonb and not qcte.business_code_list @> '1103'::jsonb then 1 else 0 end),0) as "allConsumeCount",
    COALESCE(sum ( case when qcte."type" = 'Consumption' and not qcte.business_code_list @> '1001'::jsonb and not qcte.business_code_list @> '1008'::jsonb and not qcte.business_code_list @> '1009'::jsonb and not qcte.business_code_list @> '1013'::jsonb and not qcte.business_code_list @> '1015'::jsonb then qcte.usd_amount else 0 end) - sum (case when qcte.business_code_list @> '1105'::jsonb then qcte.usd_amount else 0 end),0) as "allConsumeAmount",
