         AND NOT qcte.business_code_list @> '1001'::jsonb
         AND NOT qcte.business_code_list @> '1008'::jsonb
         AND NOT qcte.business_code_list @> '1009'::jsonb
         AND NOT qcte.business_code_list @> '1011'::jsonb
         AND NOT qcte.business_code_list @> '1013'::jsonb
         AND NOT qcte.business_code_list @> '1015'::jsonb
         AND NOT qcte.business_code_list @> '1103'::jsonb
        THEN 1 ELSE 0
    END), 0) AS "allConsumeCount",
    COALESCE(SUM(CASE
        WHEN qcte."type" = 'Consumption'
         AND NOT qcte.business_code_list @> '1001'::jsonb
         AND NOT qcte.business_code_list @> '1008'::jsonb
         AND NOT qcte.business_code_list @> '1009'::jsonb
         AND NOT qcte.business_code_list @> '1013'::jsonb
         AND NOT qcte.business_code_list @> '1015'::jsonb
        THEN qcte.usd_amount ELSE 0
    END) - SUM(CASE
        WHEN qcte.business_code_list @> '1105'::jsonb
        THEN qcte.usd_amount ELSE 0
    END), 0) AS "allConsumeAmount",
    COALESCE(SUM(CASE
        WHEN qcte."type" = 'Consumption'
         AND qcte.status = 'Fail'
         AND NOT qcte.business_code_list @> '1008'::jsonb
         AND NOT qcte.business_code_list @> '1009'::jsonb
         AND NOT qcte.business_code_list @> '1011'::jsonb
         AND NOT qcte.business_code_list @> '1013'::jsonb
         AND NOT qcte.business_code_list @> '1015'::jsonb
        THEN 1 ELSE 0
    END), 0) AS "rejectCount",
    COALESCE(SUM(CASE
        WHEN qcte."type" = 'Consumption'
