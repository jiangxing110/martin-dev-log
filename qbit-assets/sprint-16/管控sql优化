        THEN qcte.usd_amount ELSE 0
    END) - SUM(CASE
        WHEN qcte.business_code_list @> '1105'::jsonb
        THEN qcte.usd_amount ELSE 0
    END), 0) AS "unVerifyAmount",
    COALESCE(SUM(CASE
        WHEN qcte."type" = 'Consumption'
         AND qcte.status = 'Closed'
         AND NOT qcte.business_code_list @> '1001'::jsonb
         AND NOT qcte.business_code_list @> '1006'::jsonb
         AND NOT qcte.business_code_list @> '1103'::jsonb
         AND NOT qcte.business_code_list @> '1010'::jsonb
         AND NOT qcte.business_code_list @> '1011'::jsonb
         AND NOT qcte.business_code_list @> '1013'::jsonb
        THEN 1 ELSE 0
    END), 0) AS "closeCount",
    COALESCE(SUM(CASE
        WHEN qcte."type" = 'Consumption'
         AND qcte.status = 'Closed'
         AND NOT qcte.business_code_list @> '1001'::jsonb
         AND NOT qcte.business_code_list @> '1006'::jsonb
         AND NOT qcte.business_code_list @> '1013'::jsonb
        THEN qcte.usd_amount ELSE 0
    END) - SUM(CASE
        WHEN qcte.business_code_list @> '1105'::jsonb
        THEN qcte.usd_amount ELSE 0
    END), 0) AS "closeAmount",
    COALESCE(SUM(CASE
        WHEN qcte."type" = 'Consumption'
         AND qcte.status = 'Closed'
         AND NOT qcte.business_code_list @> '1001'::jsonb
         AND NOT qcte.business_code_list @> '1006'::jsonb
         AND NOT qcte.business_code_list @> '1103'::jsonb
         AND NOT qcte.business_code_list @> '1010'::jsonb
         AND NOT qcte.business_code_list @> '1011'::jsonb
         AND NOT qcte.business_code_list @> '1013'::jsonb
        THEN 1 ELSE 0
    END) - SUM(CASE
        WHEN qcte."type" = 'Credit'
         AND NOT qcte.business_code_list @> '1105'::jsonb
        THEN 1 ELSE 0
    END), 0) AS "effectiveCount",
    COALESCE(SUM(CASE
        WHEN qcte."type" = 'Consumption'
         AND qcte.status = 'Closed'
         AND NOT qcte.business_code_list @> '1001'::jsonb
         AND NOT qcte.business_code_list @> '1006'::jsonb
         AND NOT qcte.business_code_list @> '1013'::jsonb
        THEN qcte.usd_amount ELSE 0
    END) - SUM(CASE
        WHEN qcte."type" = 'Credit'
        THEN qcte.usd_amount ELSE 0
    END), 0) AS "effectiveAmount",
    COALESCE(SUM(CASE WHEN qcte."type" = 'Reversal' THEN 1 ELSE 0 END), 0) AS "reversalCount",
    COALESCE(SUM(CASE WHEN qcte."type" = 'Reversal' THEN qcte.usd_amount ELSE 0 END), 0) AS "reversalAmount",
    COALESCE(SUM(CASE WHEN qcte.business_code_list @> '1001'::jsonb THEN 1 ELSE 0 END), 0) AS "mandatoryCount",
    COALESCE(SUM(CASE WHEN qcte.business_code_list @> '1001'::jsonb THEN qcte.usd_amount ELSE 0 END), 0) AS "mandatoryAmount",
    COALESCE(SUM(CASE WHEN qcte.business_code_list @> '1013'::jsonb THEN 1 ELSE 0 END), 0) AS "theftbrushCount",
    COALESCE(SUM(CASE WHEN qcte.business_code_list @> '1013'::jsonb THEN qcte.usd_amount ELSE 0 END), 0) AS "theftbrushAmount",
    COALESCE(SUM(CASE
