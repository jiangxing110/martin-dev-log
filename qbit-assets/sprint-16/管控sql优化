    COALESCE(sum(case when qcte."type" = 'Consumption' and qcte.status = 'Fail' and not qcte.business_code_list @> '1008'::jsonb and not qcte.business_code_list @> '1009'::jsonb and not qcte.business_code_list @> '1013'::jsonb and not qcte.business_code_list @> '1015'::jsonb then qcte.usd_amount else 0 end),0) as "rejectAmount",
    COALESCE(sum(case when qcte."type" = 'Credit' and not qcte.business_code_list @>'1105'::jsonb then 1 else 0 end ),0) as "creditCount",
    COALESCE(sum(case when qcte."type" = 'Credit' and not qcte.business_code_list @>'1105'::jsonb then qcte.usd_amount else 0 end),0) as "creditAmount",
    COALESCE(sum(case when qcte."type" = 'Consumption' and not qcte.business_code_list @> '1001'::jsonb and not qcte.business_code_list @> '1006'::jsonb and not qcte.business_code_list @> '1008'::jsonb and not qcte.business_code_list @> '1009'::jsonb and not qcte.business_code_list @> '1103'::jsonb and not qcte.business_code_list @> '1010'::jsonb and not qcte.business_code_list @> '1011'::jsonb and not qcte.business_code_list @> '1013'::jsonb and not qcte.business_code_list @> '1015'::jsonb then 1 else 0 end),0) as "unVerifyCount",
    COALESCE(sum ( case when qcte."type" = 'Consumption' and not qcte.business_code_list @> '1001'::jsonb and not qcte.business_code_list @> '1006'::jsonb and not qcte.business_code_list @> '1008'::jsonb and not qcte.business_code_list @> '1009'::jsonb and not qcte.business_code_list @> '1013'::jsonb and not qcte.business_code_list @> '1015'::jsonb then qcte.usd_amount else 0 end ) - sum (case when qcte.business_code_list @>'1105'::jsonb then qcte.usd_amount else 0 end ),0) as "unVerifyAmount",
    COALESCE(sum(case when qcte."type" = 'Consumption' and qcte.status = 'Closed' and not qcte.business_code_list @> '1001'::jsonb and not qcte.business_code_list @> '1006'::jsonb and not qcte.business_code_list @> '1103'::jsonb and not qcte.business_code_list @> '1010'::jsonb and not qcte.business_code_list @> '1011'::jsonb and not qcte.business_code_list @> '1013'::jsonb then 1 else 0 end),0) as "closeCount",
    COALESCE(sum(case when qcte."type" = 'Consumption' and qcte.status = 'Closed' and not qcte.business_code_list @> '1001'::jsonb and not qcte.business_code_list @> '1006'::jsonb and not qcte.business_code_list @> '1013'::jsonb then qcte.usd_amount else 0 end ) - sum(case when qcte.business_code_list @> '1105'::jsonb then qcte.usd_amount else 0 end ),0) as "closeAmount",
    COALESCE(sum(case when qcte."type" = 'Consumption' and qcte.status = 'Closed' and not qcte.business_code_list @> '1001'::jsonb and not qcte.business_code_list @> '1006'::jsonb and not qcte.business_code_list @> '1103'::jsonb and not qcte.business_code_list @> '1010'::jsonb and not qcte.business_code_list @> '1011'::jsonb and not qcte.business_code_list @> '1013'::jsonb then 1 else 0 end ) - sum(case when qcte."type" = 'Credit' and not qcte.business_code_list @> '1105'::jsonb then 1 else 0 end ),0) as "effectiveCount",
    COALESCE(sum(case when qcte."type" = 'Consumption' and qcte.status = 'Closed' and not qcte.business_code_list @> '1001'::jsonb and not qcte.business_code_list @> '1006'::jsonb and not qcte.business_code_list @> '1013'::jsonb then qcte.usd_amount else 0 end) - sum(case when qcte."type" = 'Credit' then qcte.usd_amount else 0 end ),0) as "effectiveAmount",
    COALESCE(sum(case when qcte."type" = 'Reversal' then 1 else 0 end ),0) as "reversalCount",
    COALESCE(sum(case when qcte."type" = 'Reversal' then qcte.usd_amount else 0 end),0) as "reversalAmount",
    COALESCE(sum(case when qcte.business_code_list @> '1001'::jsonb then 1 else 0 end ),0) as "mandatoryCount",
    COALESCE(sum(case when qcte.business_code_list @>'1001'::jsonb then qcte.usd_amount else 0 end ),0) as "mandatoryAmount",
    COALESCE(sum(case when qcte.business_code_list @> '1013'::jsonb then 1 else 0 end ),0) as "theftbrushCount",
    COALESCE(sum(case when qcte.business_code_list @> '1013'::jsonb then qcte.usd_amount else 0 end ),0) as "theftbrushAmount",
