    fee_type,
    math_type
)
CROSS JOIN (
    VALUES
        ('QbitIssuing'::text),
        ('I2c'::text),
        (NULL::text)
) AS p(provider)
WHERE NOT EXISTS (
    SELECT 1
    FROM "public"."accountFee" af
    WHERE af."accountId" = '00000000-0000-0000-0000-000000000000'::uuid
      AND af."feeType" = v.fee_type
      AND af."provider" IS NOT DISTINCT FROM p.provider
