    "collectionRate"
)
SELECT
    '',
    NULL,
    1,
    '00000000-0000-0000-0000-000000000000'::uuid,
    v.fee_type,
    0,
    v.math_type,
    '2026-01-01 00:00:00+08'::timestamptz,
    '2099-12-01 23:59:59.999+08'::timestamptz,
    'Tiered',
    NULL,
    'MasterAccount',
    NULL,
    p.provider,
    NULL,
    TRUE,
