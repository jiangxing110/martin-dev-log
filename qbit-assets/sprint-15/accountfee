        ('IssuerCardServiceFeesInt_Caas', 'Percent'),
        ('IssuerTransactionFeesByAuthIntByDomestic_Caas', 'Count'),
        ('IssuerTransactionFeesByAuthInt_Caas', 'Count'),
        ('IssuerTransactionFeesSettlementIntByDomestic_Caas', 'Count'),
        ('IssuerTransactionFeesSettlementInt_Caas', 'Count'),
        ('SchemeRefundByDomestic_Caas', 'Count'),
        ('SchemeRefundByInternational_Caas', 'Count'),
        ('SchemeReversalByDomestic_Caas', 'Count'),
        ('SchemeReversalByInternational_Caas', 'Count'),
