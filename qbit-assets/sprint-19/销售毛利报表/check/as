 /**
     * 按完成时间分段查询净消费金额，降低单次 Greenplum 查询的内存峰值。
     *
     * @param filter 月账单查询条件
     * @return 各时间段净消费统计结果
     */
    private List<ApiProviderFeeExtendVO> getPurchaseNetStatisticByTimeChunks(QueryFilterDTO filter) {
        if (StringUtils.isAnyBlank(filter.getStartDate(), filter.getEndDate())) {
            return odsApiClientTransactionMapper.getPurchaseNetStatistic(filter, null, null);
        }

        LocalDateTime chunkStart = LocalDateTime.parse(filter.getStartDate(), DateUtil.DATETIME_FORMAT);
        LocalDateTime endInclusive = LocalDateTime.parse(filter.getEndDate(), DateUtil.DATETIME_FORMAT);
        // 原查询的结束时间是闭区间；转换为微秒精度的开区间，避免分段时漏掉结束时刻。
        LocalDateTime endExclusive = endInclusive.plusNanos(1_000);
        List<ApiProviderFeeExtendVO> results = new ArrayList<>();
        while (chunkStart.isBefore(endExclusive)) {
            LocalDateTime chunkEnd = chunkStart.plusDays(PURCHASE_NET_STATISTIC_CHUNK_DAYS);
            if (chunkEnd.isAfter(endExclusive)) {
                chunkEnd = endExclusive;
            }
            String completeStartTime = chunkStart.format(PURCHASE_NET_STATISTIC_CHUNK_FORMATTER);
            String completeEndTime = chunkEnd.format(PURCHASE_NET_STATISTIC_CHUNK_FORMATTER);
            log.info("分段查询净消费金额，completeTime范围：[{}, {})", completeStartTime, completeEndTime);
            results.addAll(odsApiClientTransactionMapper.getPurchaseNetStatistic(
                    filter, completeStartTime, completeEndTime));
            chunkStart = chunkEnd;
        }
        return results;
    }

private static final int PURCHASE_NET_STATISTIC_CHUNK_DAYS = 7;
    private static final DateTimeFormatter PURCHASE_NET_STATISTIC_CHUNK_FORMATTER =
            DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss.SSSSSS");

