CREATE MATERIALIZED VIEW "dws"."dws_effective_revenue_daily_mv"
AS
SELECT COALESCE(r.stat_date, c.stat_date) AS stat_date,
    COALESCE(r.category, c.category) AS category,
    COALESCE(r.account_id, c.account_id) AS account_id,
    COALESCE(r.account_type, c.account_type) AS account_type,
    COALESCE(r.system_type, c.system_type) AS system_type,
    COALESCE(r.total_revenue, (0)::numeric) AS total_revenue,
    COALESCE(c.total_cashback, (0)::numeric) AS total_cashback,
    (COALESCE(r.total_revenue, (0)::numeric) - COALESCE(c.total_cashback, (0)::numeric)) AS effective_revenue
   FROM (dws.dws_effective_revenue_daily_mv_nest_r r
     FULL JOIN dws.dws_effective_revenue_daily_mv_nest_c c ON (((r.stat_date = c.stat_date) AND ((r.category)::text = (c.category)::text) AND (r.account_id = c.account_id) AND (r.account_type = c.account_type) AND (r.system_type = c.system_type))));

