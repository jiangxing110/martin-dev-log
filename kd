SELECT
    detail.root_account_id,
    COALESCE(
        NULLIF(account."verifiedName", ''),
        account."verifiedNameEn"
    ) AS customer_name,
    detail.product,
    detail.source_type,
    detail.provider,
    detail.effective_revenue,
    detail.cogs,
    detail.gp,
    detail.commission_rate,
    detail.commission_amount
FROM dws.dws_sales_commission_snapshot_detail_p detail
LEFT JOIN account account
    ON account.id::varchar = detail.root_account_id
WHERE detail.delete_time IS NULL
  AND detail.settlement_month = DATE '2026-09-01'
  AND detail.commission_stage = 'current_payout'
  AND detail.sale_id = 'edfc4d0a-2131-440f-87a3-f3781767fa7f'
  AND detail.product IN ('qbit_card', 'open_api')
  AND detail.provider IS NULL
ORDER BY detail.product, detail.root_account_id;

