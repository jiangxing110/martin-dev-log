SELECT
    'view' AS object_type,
    schemaname AS schema_name,
    viewname AS object_name,
    definition
FROM pg_views
WHERE definition ILIKE '%dws_sales_commission_snapshot_detail_p%'
   OR definition ILIKE '%real_time_processing_fee%'

UNION ALL

SELECT
    CASE p.prokind
        WHEN 'p' THEN 'procedure'
        ELSE 'function'
    END AS object_type,
    n.nspname AS schema_name,
    p.proname AS object_name,
    pg_get_functiondef(p.oid) AS definition
FROM pg_proc p
JOIN pg_namespace n ON n.oid = p.pronamespace
WHERE p.prokind IN ('f', 'p')
  AND (
      pg_get_functiondef(p.oid) ILIKE '%dws_sales_commission_snapshot_detail_p%'
      OR pg_get_functiondef(p.oid) ILIKE '%real_time_processing_fee%'
  )
ORDER BY schema_name, object_name;

INSERT INTO "MY_TABLE"(object_type, schema_name, object_name, definition) VALUES ('view', 'dws', 'v_sales_commission_recent_estimate_base', e' WITH account_root_relation AS (
         SELECT ods_api_account_relation.account_id,
            ods_api_account_relation.root_id
           FROM ods.ods_api_account_relation
          WHERE (ods_api_account_relation.delete_time IS NULL)
        ), rule_departments AS (
         SELECT DISTINCT dim_sales_commission_rule.department_id
           FROM dim.dim_sales_commission_rule
          WHERE ((dim_sales_commission_rule.enabled = true) AND (dim_sales_commission_rule.delete_time IS NULL))
        ), sale_department_mapping AS (
         SELECT ranked.sale_id,
            ranked.department_id
           FROM ( SELECT (sud.user_id)::text AS sale_id,
                    (sud.department_id)::text AS department_id,
                    row_number() OVER (PARTITION BY (sud.user_id)::text ORDER BY
                        CASE
                            WHEN (rd.department_id IS NOT NULL) THEN 0
                            ELSE 1
                        END, sud.update_time DESC, sud.id DESC) AS rn
                   FROM (system_user_department sud
                     LEFT JOIN rule_departments rd ON (((rd.department_id)::text = (sud.department_id)::text)))
                  WHERE (sud.delete_time IS NULL)) ranked
          WHERE (ranked.rn = 1)
        ), revenue_base AS (
         SELECT CURRENT_DATE AS report_date,
            r.settlement_month,
            r.root_account_id,
            r.product,
            r.provider,
                CASE
                    WHEN (((r.product)::text = \'open_api\'::text) AND ((r.metric_code)::text = ANY ((ARRAY[\'api_one_time_fee\'::character varying, \'api_monthly_fee\'::character varying])::text[]))) THEN r.metric_code
                    ELSE NULL::character varying
                END AS item,
                CASE
                    WHEN (((r.product)::text = \'open_api\'::text) AND ((r.metric_code)::text = \'api_monthly_fee\'::text)) THEN \'api_monthly_billing\'::text
                    WHEN (((r.product)::text = \'open_api\'::text) AND ((r.metric_code)::text = \'month_receivable\'::text)) THEN \'billing_decline_fee\'::text
                    WHEN (((r.product)::text = \'open_api\'::text) AND ((r.metric_code)::text = \'month_revenue\'::text)) THEN \'past_due_invoice\'::text
                    WHEN ((r.metric_code)::text = \'past_due_invoice\'::text) THEN \'past_due_invoice\'::text
                    WHEN ((r.metric_code)::text = \'billing_decline_fee\'::text) THEN \'billing_decline_fee\'::text
                    ELSE \'real_time_processing_fee\'::text
                END AS source_type,
                CASE
                    WHEN (((r.product)::text = \'open_api\'::text) AND ((r.metric_code)::text = \'api_monthly_fee\'::text)) THEN \'future_payout\'::text
                    ELSE \'current_payout\'::text
                END AS commission_stage,
            r.sale_id,
            COALESCE(r.sale_department, (sdm.department_id)::character varying) AS department_id,
            r.operation_manager_id,
            r.am_id,
            r.settlement_month AS activity_month,
            r.settlement_month AS collection_month,
                CASE
                    WHEN (((r.product)::text = \'open_api\'::text) AND ((r.metric_code)::text = \'api_monthly_fee\'::text)) THEN (date_trunc(\'month\'::text, (r.settlement_month + \'1 mon\'::interval)))::date
                    ELSE r.settlement_month
                END AS payable_settlement_month,
            (sum(COALESCE(r.real_income_value, r.income_value, (0)::numeric)))::numeric(20,4) AS effective_revenue
           FROM (dws.dws_sales_revenue_monthly r
             LEFT JOIN sale_department_mapping sdm ON ((sdm.sale_id = (COALESCE(r.sale_id, r.am_id))::text)))
          WHERE ((r.delete_time IS NULL) AND (r.settlement_month >= (date_trunc(\'month\'::text, (CURRENT_DATE - \'3 mons\'::interval)))::date) AND ((r.metric_code)::text <> ALL ((ARRAY[\'assets_acceptance_fee_gt_zero\'::character varying, \'assets_acceptance_fee_eq_zero\'::character varying, \'physical_card_cost\'::character varying])::text[])))
          GROUP BY r.settlement_month, r.root_account_id, r.product, r.provider, r.metric_code, r.sale_id, COALESCE(r.sale_department, (sdm.department_id)::character varying), r.operation_manager_id, r.am_id
        ), global_account_channel_cost AS (
         SELECT c.source_month AS settlement_month,
            COALESCE(aar.root_id, c.account_id) AS root_account_id,
            \'group_account\'::text AS product,
            c.provider,
            (sum(COALESCE(c.cost_amount, (0)::numeric)))::numeric(20,4) AS cogs
           FROM (dwm.dwm_finance_channel_cost_p c
             LEFT JOIN account_root_relation aar ON (((aar.account_id)::text = (c.account_id)::text)))
          WHERE ((c.delete_time IS NULL) AND (c.source_month >= (date_trunc(\'month\'::text, (CURRENT_DATE - \'3 mons\'::interval)))::date) AND ((c.product_line)::text = \'GLOBAL_ACCOUNT\'::text) AND ((c.provider)::text = ANY ((ARRAY[\'BZ\'::character varying, \'CL\'::character varying])::text[])))
          GROUP BY c.source_month, COALESCE(aar.root_id, c.account_id), c.provider
        ), qbit_card_bb_cost AS (
         SELECT (date_trunc(\'month\'::text, (b.report_date)::timestamp with time zone))::date AS settlement_month,
            COALESCE(aar.root_id, b.account_id) AS root_account_id,
            \'qbit_card\'::text AS product,
            \'BB\'::text AS provider,
            (sum((((((((((((((((((((((((((((COALESCE(b.m_dom_auth_count, 0))::numeric * 0.1090) + ((COALESCE(b.m_int_auth_count, 0))::numeric * 0.4845)) + ((COALESCE(b.v_dom_auth_count, 0))::numeric * 0.0725)) + ((COALESCE(b.v_int_auth_count, 0))::numeric * 0.4700)) + ((COALESCE(b.m_int_decline_count, 0))::numeric * 0.3595)) + ((COALESCE(b.v_int_decline_count, 0))::numeric * 0.3570)) + ((COALESCE(b.dom_decline_count, 0))::numeric * 0.0890)) + ((COALESCE(b.m_int_reversal_count, 0))::numeric * 0.7190)) + ((COALESCE(b.v_int_reversal_count, 0))::numeric * 0.7140)) + ((COALESCE(b.dom_reversal_count, 0))::numeric * 0.1780)) + ((COALESCE(b.m_int_refund_count, 0))::numeric * 0.4845)) + ((COALESCE(b.v_int_refund_count, 0))::numeric * 0.4770)) + ((COALESCE(b.dom_refund_count, 0))::numeric * 0.1090)) + ((COALESCE(b.av_m_dom_count, 0))::numeric * 0.1090)) + ((COALESCE(b.av_m_int_count, 0))::numeric * 0.4845)) + ((COALESCE(b.av_v_dom_count, 0))::numeric * 0.0725)) + ((COALESCE(b.av_v_int_count, 0))::numeric * 0.4770)) + ((COALESCE(b.m_int_decline_count, 0))::numeric * 0.3595)) + ((COALESCE(b.v_int_decline_count, 0))::numeric * 0.3570)) + ((COALESCE(b.dom_decline_count, 0))::numeric * 0.0890)) + (COALESCE(b.m_dom_clearing_vol, (0)::numeric) * \'-0.0021\'::numeric)) + (COALESCE(b.m_int_clearing_vol, (0)::numeric) * \'-0.0111\'::numeric)) + (COALESCE(b.v_dom_clearing_vol, (0)::numeric) * \'-0.0016\'::numeric)) + (COALESCE(b.v_int_clearing_vol, (0)::numeric) * \'-0.0116\'::numeric)) + ((COALESCE(b.active_card_count, 0))::numeric * 0.1000)) + COALESCE(b.cost_fixed_fee, (0)::numeric))))::numeric(20,4) AS cogs
           FROM (dws.dws_bb_card_finance_daily_p b
             LEFT JOIN account_root_relation aar ON (((aar.account_id)::text = (b.account_id)::text)))
          WHERE ((b.delete_time IS NULL) AND (b.report_date >= (date_trunc(\'month\'::text, (CURRENT_DATE - \'3 mons\'::interval)))::date))
          GROUP BY ((date_trunc(\'month\'::text, (b.report_date)::timestamp with time zone))::date), COALESCE(aar.root_id, b.account_id)
        ), qbit_card_qi_cost AS (
         SELECT (date_trunc(\'month\'::text, (q.report_date)::timestamp with time zone))::date AS settlement_month,
            COALESCE(aar.root_id, q.account_id) AS root_account_id,
            \'qbit_card\'::text AS product,
            \'QI\'::text AS provider,
            (sum((((((((((COALESCE(q.cost_reimbursement_base_amt, (0)::numeric) * COALESCE(q.cost_reimbursement_rate, (0)::numeric)) + (COALESCE(q.cost_service_base_amt, (0)::numeric) * COALESCE(q.cost_service_rate, (0)::numeric))) + (COALESCE(q.cost_acs_regular_base_amt, (0)::numeric) * COALESCE(q.cost_acs_regular_rate, (0)::numeric))) + (COALESCE(q.cost_acs_vip_base_amt, (0)::numeric) * COALESCE(q.cost_acs_vip_rate, (0)::numeric))) + (COALESCE(q.cost_vrm_base_amt, (0)::numeric) * COALESCE(q.cost_vrm_rate, (0)::numeric))) + (COALESCE(q.cost_hk_regular_base_amt, (0)::numeric) * COALESCE(q.cost_hk_regular_rate, (0)::numeric))) + (COALESCE(q.cost_hk_vip_base_amt, (0)::numeric) * COALESCE(q.cost_hk_vip_rate, (0)::numeric))) + (COALESCE(q.cost_dcsf_base_amt, (0)::numeric) * COALESCE(q.cost_dcsf_rate, (0)::numeric))) + COALESCE(q.cost_fixed_fee, (0)::numeric))))::numeric(20,4) AS cogs
           FROM (dws.dws_qi_card_finance_daily_v2_p q
             LEFT JOIN account_root_relation aar ON (((aar.account_id)::text = (q.account_id)::text)))
          WHERE ((q.delete_time IS NULL) AND (q.report_date >= (date_trunc(\'month\'::text, (CURRENT_DATE - \'3 mons\'::interval)))::date))
          GROUP BY ((date_trunc(\'month\'::text, (q.report_date)::timestamp with time zone))::date), COALESCE(aar.root_id, q.account_id)
        ), qbit_card_sl_cost AS (
         SELECT (date_trunc(\'month\'::text, (s.report_date)::timestamp with time zone))::date AS settlement_month,
            COALESCE(aar.root_id, s.account_id) AS root_account_id,
            \'qbit_card\'::text AS product,
            \'SL\'::text AS provider,
            (sum(COALESCE(s.cost_fixed_fee, (0)::numeric)))::numeric(20,4) AS cogs
           FROM (dws.dws_sl_card_finance_daily_p s
             LEFT JOIN account_root_relation aar ON (((aar.account_id)::text = (s.account_id)::text)))
          WHERE ((s.delete_time IS NULL) AND (s.report_date >= (date_trunc(\'month\'::text, (CURRENT_DATE - \'3 mons\'::interval)))::date))
          GROUP BY ((date_trunc(\'month\'::text, (s.report_date)::timestamp with time zone))::date), COALESCE(aar.root_id, s.account_id)
        ), qbit_card_bpc_cost AS (
