SELECT DISTINCT
       a.id AS account_id,
       kyb.status AS kyb_status,
       main_business.value AS main_business,
       purpose.token AS matched_purpose
FROM account a
JOIN "cddKyb" kyb
  ON kyb."accountId"::uuid = a.id
 AND kyb."deleteTime" IS NULL
 AND kyb."isLatest" = TRUE
 AND kyb."businessType" = 'MultiCurrencyAccount'
 AND kyb.status = 'Passed'
JOIN "cddKybDetail" main_business
  ON main_business."kybId" = kyb.id
 AND main_business."deleteTime" IS NULL
 AND main_business.key = 'mainBusiness'
 AND main_business.value = 'B2B'
JOIN "cddKybDetail" purpose_detail
  ON purpose_detail."kybId" = kyb.id
 AND purpose_detail."deleteTime" IS NULL
 AND purpose_detail.key = 'accountPurpose'
CROSS JOIN LATERAL regexp_split_to_table(purpose_detail.value, '[,，;；]')
    AS purpose(token)
WHERE a."deleteTime" IS NULL
  AND a.status NOT IN ('Cleared', 'Inactive')
  AND a.type NOT IN ('ApiClientCustomer')
  AND LOWER(BTRIM(purpose.token)) IN (
      'paytosupplier',
      'paytodistributor',
      'supplier',
      'distributor',
      '付款-至供货商或经销商'
  )
ORDER BY a.id;
select *
from "cddKybDetail" where key='accountPurpose';

