SELECT
    product,
    source_type,
    COALESCE(provider, '<NULL>') AS provider,
    COUNT(*) AS row_count,
    SUM(effective_revenue) AS effective_revenue,
    SUM(cogs) AS cogs,
    SUM(gp) AS gp,
    SUM(commission_amount) AS commission_amount
FROM dws.dws_sales_commission_snapshot_detail_p
WHERE delete_time IS NULL
  AND settlement_month = DATE '2026-09-01'
  AND commission_stage = 'current_payout'
  AND sale_id = 'edfc4d0a-2131-440f-87a3-f3781767fa7f'
  AND product IN ('qbit_card', 'open_api')
GROUP BY product, source_type, provider
ORDER BY product, source_type, provider;

