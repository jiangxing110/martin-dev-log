CREATE TABLE "dws"."dws_tpv_metrics" (
  "entity" varchar COLLATE "pg_catalog"."default" NOT NULL,
  "state_date" date NOT NULL,
  "product" varchar COLLATE "pg_catalog"."default" NOT NULL,
  "business_domain" varchar COLLATE "pg_catalog"."default" NOT NULL,
  "metric_code" varchar COLLATE "pg_catalog"."default" NOT NULL,
  "metric_name" varchar COLLATE "pg_catalog"."default" NOT NULL,
  "metric_label" varchar COLLATE "pg_catalog"."default" NOT NULL,
  "metric_type" varchar COLLATE "pg_catalog"."default" NOT NULL,
  "metric_value" numeric(20,3),
  "source_system" varchar COLLATE "pg_catalog"."default",
  "create_time" timestamp(6),
  CONSTRAINT "dws_tpv_metrics_pkey" PRIMARY KEY ("entity", "state_date", "product", "business_domain", "metric_code", "metric_name", "metric_label", "metric_type")
)
;
SELECT product,business_domain,metric_name,metric_code
FROM dws_tpv_metrics 
WHERE product not in ('acquiring','crypto','global_account','treasury','crypto_connect','open_api')
and metric_code not in ('card_consumption_amount','interchange_revenue_amount','active_physical_card_count','card_consumption_amount','fees','fx_markup')
and metric_code not in ('qi_interchange_income_amount','bb_interchange_income_amount','pc_interchange_income_amount','bz_interchange_income_amount','customer_cash_back_amount')
GROUP BY product,business_domain,metric_name,metric_code

